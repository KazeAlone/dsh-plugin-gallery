{
  "name": "dsh-plugin-gallery",
  "version": "0.22.1",
  "description": "Local DSH resource gallery for skills, agents, MCP and workflows",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./dist/client.js",
    "./sdk": "./src/client-api.mjs",
    "./storage": "./src/store.mjs",
    "./identity": "./src/identity.mjs",
    "./server": "./src/server.mjs"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3 || 0.2.1-rc.5",
    "react": ">=18 <20",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build && npm run check && npm test",
    "format": "prettier --write src scripts test"
  },
  "license": "MIT",
  "bin": {
    "dsh-gallery": "./scripts/gallery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
